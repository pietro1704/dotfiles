mise() {
  unfunction mise 2>/dev/null
  # Mantém os shims como mecanismo único; a ativação completa fazia `mise doctor`
  # reportar falsamente todos os shims como ausentes neste PATH.
  eval "$(command mise activate zsh --shims)"
  mise "$@"
}


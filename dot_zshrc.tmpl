# ── NVM — lazy ────────────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
NVM_SCRIPT="$NVM_DIR/nvm.sh"
NVM_COMPLETION="$NVM_DIR/bash_completion"
if [ ! -s "$NVM_SCRIPT" ] && [ -n "$HOMEBREW_PREFIX" ]; then
  NVM_SCRIPT="$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
  NVM_COMPLETION="$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"
fi
if [ -s "$NVM_SCRIPT" ]; then
  _lazy_load_nvm() {
    unfunction nvm node npm npx 2>/dev/null
    \. "$NVM_SCRIPT"
    [ -s "$NVM_COMPLETION" ] && \. "$NVM_COMPLETION"
  }
  nvm()  { _lazy_load_nvm; nvm  "$@"; }
  node() { _lazy_load_nvm; node "$@"; }
  npm()  { _lazy_load_nvm; npm  "$@"; }
  npx()  { _lazy_load_nvm; npx  "$@"; }
fi


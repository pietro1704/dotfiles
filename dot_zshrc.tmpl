# Attach nativo do Herdr ao servidor remoto; não usa tmux nem compartilha panes locais.
arch() {
  if [[ "${HERDR_ENV:-}" == 1 ]]; then
    print -u2 '· Este shell já está dentro do Herdr; abra o perfil arch-herdr pelo cliente principal do Herdr.'
    return 2
  fi
  command herdr --remote arch --session main
}

updateAll() {
  export HOMEBREW_NO_AUTO_UPDATE=1
  export HOMEBREW_NO_ENV_HINTS=1
  export HOMEBREW_NO_INSTALL_CLEANUP=1
  export HOMEBREW_NO_INSTALL_UPGRADE=1
  export NONINTERACTIVE=1

  local failed=0 formula
  local skip_formulae=(
    edencommon fb303 fbthrift fizz folly mvfst wangle
    llvm llvm@22 watchman xcodes mise
  )

  echo '→ Atualizando MacPorts...'
  if command -v port >/dev/null 2>&1; then
    # -N: modo não interativo; sudo ainda pode pedir autenticação do macOS.
    sudo port -N selfupdate || failed=1
    sudo port -N upgrade outdated || failed=1
  else
    echo '· MacPorts não encontrado no PATH'
    failed=1
  fi

  echo '→ Atualizando Homebrew...'
  brew update || failed=1

  while IFS= read -r formula; do
    [[ -z "$formula" ]] && continue
    if (( ${skip_formulae[(I)$formula]} )); then
      echo "· Pulando fórmula pesada/legada: $formula"
      continue
    fi
    echo "→ Atualizando fórmula: $formula"
    brew upgrade --formula --yes "$formula" || failed=1
  done < <(brew outdated --formula --quiet)

  echo '→ Atualizando casks instalados...'
  brew upgrade --cask --yes || failed=1
  brew cleanup --prune=30 || failed=1

  if [[ -x "$ZSH/tools/upgrade.sh" ]]; then
    echo '→ Atualizando oh-my-zsh...'
    LANG= ZSH="$ZSH" zsh -f "$ZSH/tools/upgrade.sh" || failed=1
  fi

  if command -v claude >/dev/null 2>&1; then
    echo '→ Atualizando Claude Code...'
    claude update || failed=1
  fi

  # Hermes update/check removido do updateAll: no Mac ele pode recriar o venv/repo
  # e quebrar o restante da manutenção. Atualize manualmente com: hermes update

  if command -v tmux >/dev/null 2>&1 && [[ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ]]; then
    echo '→ Atualizando plugins do tmux...'
    tmux start-server
    "$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null || echo '· tmux plugins: install falhou (ignorado)'
    if [[ -d "$HOME/.tmux/plugins/tpm/.git" ]]; then
      git -C "$HOME/.tmux/plugins/tpm" pull --ff-only || true
    fi
    local plugin_dir
    for plugin_dir in "$HOME"/.tmux/plugins/*; do
      [[ -d "$plugin_dir/.git" ]] || continue
      git -C "$plugin_dir" pull --ff-only || true
    done
    tmux run-shell "$HOME/.tmux/plugins/tpm/scripts/clean_plugins.sh" >/dev/null 2>&1 || true
  fi

  if (( failed )); then
    echo '⚠ updateAll terminou com falhas'
    return 1
  fi
  echo '✓ updateAll concluído'
}
alias vim=nvim
[ -n "$HOMEBREW_PREFIX" ] && alias ctags="$HOMEBREW_PREFIX/bin/ctags"
alias shopt='/usr/bin/shopt'
alias sshLinux='ssh pietro@pietro-linux'

# cleanAllCache — limpa caches de user apps (NÃO ~/Library/Developer/Xcode/DerivedData → usa `mxc`).
cleanAllCache() {
    sudo rm -rf \
        "$HOME/Library/Caches" \
        "$HOME/Library/Logs" \
        /private/var/log/asl \
        "$HOME/Library/Containers/com.apple.mail/Data/Library/Mail Downloads" \
        /private/var/db/diagnostics \
        "$HOME/Library/Containers/com.apple.iMovieApp/Data/Library/Caches" \
        "$HOME/Library/Containers/com.apple.Safari/Data/Library/Caches" \
        /Library/Logs \
        "$HOME/Library/Containers/com.apple.iBooksX/Data/Library/Caches" \
        "$HOME/Library/Application Support/Code/Cache" \
        "$HOME/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/Cache" \
        "$HOME/Library/Application Support/discord/Cache" \
        "$HOME/Library/Containers/com.apple.mail/Data/Library/Caches" \
        "$HOME/Library/Containers/com.apple.QuickTimePlayerX/Data/Library/Caches/com.apple.avkit.thumbnailCache" 2>/dev/null
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder
}

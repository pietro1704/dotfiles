# Carregado em TODOS os contextos zsh (interativo, não-interativo, scripts)
# Mantenha leve — só o essencial

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

{{ if eq .chezmoi.os "linux" -}}
export LANG="pt_BR.UTF-8"
export LC_ALL="pt_BR.UTF-8"
{{ else -}}
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
{{ end -}}
export LC_NUMERIC="en_US.UTF-8"

{{ if eq .chezmoi.os "darwin" -}}
# macOS: evita "too many open files" em builds grandes (Xcode/SPM)
ulimit -n 65536 2>/dev/null
# Evita crash de fork em Ruby/scripts que tocam em Obj-C runtime
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
# Stable entry points in interactive shells, scripts, SSH and clean directories.
# Drop inherited version-specific mise paths; shims select global/project pins.
if [[ -d "$HOME/.local/share/mise/shims" ]]; then
  typeset -U path
  path=("$HOME/.local/share/mise/shims" "$HOME/.local/bin" ${path:#${HOME}/.local/share/mise/installs/*})
  if [[ -n ${VIRTUAL_ENV:-} && -d "$VIRTUAL_ENV/bin" ]]; then
    path=("$VIRTUAL_ENV/bin" $path)
  fi
  export PATH
fi
{{ end -}}
